<!DOCTYPE html>
<html>

<head>
    <title>Ofertas</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <nav>
        <a href="/">Home</a>
        <a href="/quemsou">Quem Sou</a>
        <a href="/ofertas">Ofertas</a>
        <a href="/novos">Novos</a>
        <a href="/seminovos">Seminovos</a>
    </nav>
    <h1> Serviços Disponiveis</h1>
    <div class="container">
        <% ofertas.forEach(oferta=>{ %>
            <div class="card">
                <img src="<%= oferta.imagem %>">
                <h2>
                    <%= oferta.servico %>
                </h2>
                <p>
                    <%= oferta.descricao %>
                </p>
                <strong>
                    <%= oferta.vagas %>
                </strong>
            </div>

            <%}) %>

    </div>
    <br>
    <a href="/" class="botao-voltar">Voltar</a>
</body>

</html>